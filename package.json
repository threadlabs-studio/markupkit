{
  "name": "@threadlabs/markupkit",
  "version": "0.5.0",
  "description": "Build applications with HTML, CSS, and JavaScript, powered by HTML Next.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./components/*": "./components/*",
    "./description": {
      "types": "./dist/description.d.ts",
      "import": "./dist/description.js"
    }
  },
  "files": [
    "dist",
    "components"
  ],
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15 <25"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "pnpm build && vitest run --exclude tests/package.test.ts",
    "typecheck": "pnpm build && tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "build:docs-proof": "tsx examples/docs/build.ts",
    "measure:delivery": "tsx scripts/measure-delivery.ts",
    "measure:navigation": "tsx scripts/measure-navigation.ts",
    "measure:server": "tsx scripts/measure-server.ts",
    "lint": "oxlint --deny-warnings .",
    "test:package": "vitest run tests/package.test.ts",
    "test:browser": "pnpm build && vitest run --config vitest.browser.config.ts",
    "verify:inner": "pnpm lint && pnpm typecheck && pnpm test",
    "verify:pr": "pnpm verify:inner && pnpm build && pnpm test:package && pnpm build:site",
    "verify:release": "pnpm verify:pr",
    "build:site": "markupress build --root website"
  },
  "dependencies": {
    "@nextwebwg/html-next": ">=1.0.0-alpha.71",
    "typescript-compiler": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.4",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4",
    "playwright": "1.64.0",
    "marked": "18.1.1",
    "tsx": "4.23.15",
    "oxlint": "1.81.0",
    "markupress": ">=0.14.4",
    "@threadlabs/looma": ">=0.44.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/markupkit.git"
  },
  "bin": {
    "markupkit": "./dist/cli.js"
  },
  "packageManager": "pnpm@12.9.1",
  "homepage": "https://threadlabs.studio/markupkit/",
  "bugs": {
    "url": "https://github.com/threadlabs-studio/markupkit/issues"
  }
}
