{
  "name": "@threadlabs/system-ui",
  "version": "0.1.0-alpha.0",
  "description": "Shared application models, HTML Next compositions and native presenters for MarkupKit.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js"
    },
    "./components/*": "./components/*",
    "./web.css": "./components/web.css",
    "./native/*": "./native/*",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./markupkit": {
      "types": "./dist/markupkit.d.ts",
      "import": "./dist/markupkit.js"
    }
  },
  "files": [
    "dist",
    "components",
    "native"
  ],
  "engines": {
    "node": ">=22.22.2 <23 || >=24.15"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test:native": "tsx scripts/test-native.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "devDependencies": {
    "@threadlabs/markupkit": "workspace:>=0.11.0",
    "@nextwebwg/html-next": ">=1.0.0-alpha.87",
    "@threadlabs/looma": ">=0.49.0",
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "playwright": "1.65.0",
    "tsx": "4.23.15"
  },
  "peerDependencies": {
    "@threadlabs/markupkit": ">=0.11.0",
    "@nextwebwg/html-next": ">=1.0.0-alpha.87",
    "@threadlabs/looma": ">=0.49.0"
  },
  "peerDependenciesMeta": {
    "@threadlabs/markupkit": {
      "optional": true
    },
    "@nextwebwg/html-next": {
      "optional": true
    },
    "@threadlabs/looma": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadlabs-studio/markupkit.git",
    "directory": "packages/system-ui"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  }
}
